{
  "name": "shubh-vivah-invitation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cinematic, scroll-driven Indian wedding invitation website.",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:mobile": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@rolldown/binding-win32-x64-msvc": "^1.2.16",
    "framer-motion": "^14.9.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
